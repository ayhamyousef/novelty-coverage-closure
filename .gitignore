sim_build/
__pycache__/
*.pyc
.venv/
*.vcd
*.fst

# cocotb's JUnit XML embeds wall-clock timing, so it differs on every run and
# produces noisy diffs. The coverage artifacts beside it are deterministic
# (verified: byte-identical across reruns and across both simulators) and are
# committed as the actual raw data.
results/**/results_*.xml

# Per-run probe intermediates. probe_summary.json holds every record verbatim,
# so these are regenerable duplicates rather than data.
results/stage2/probe_lg*.json

# Per-test coverage records. model_check.json holds every record verbatim.
results/stage3/cov_*.json
